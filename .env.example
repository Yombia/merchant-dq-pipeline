# Copy to .env:  cp .env.example .env
# Local-only credentials for the demo stack. Do not reuse anywhere real.

DWH_USER=dwh
DWH_PASSWORD=dwh
DWH_DB=dwh

# Linux only: set to your user id (`id -u`) so files Airflow writes stay yours.
# macOS / Windows (Docker Desktop): leave as is.
AIRFLOW_UID=50000

AIRFLOW_JWT_SECRET=local-dev-only-secret
